# Copy this file to .env.local for local development. In Vercel, set the same
# names under Project Settings → Environment Variables. Never commit a file
# with real values — .env* is gitignored.

# --- Supabase ---
# Project URL and anon (public) key, from Supabase dashboard → Project Settings → API.
# Safe to expose to the browser: RLS is what actually protects data, not secrecy of these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, same dashboard page. Bypasses RLS entirely — never expose this to
# the browser. Used only in src/lib/supabase/admin.ts and other server-only modules.
# Also needed (same value) as a GitHub Actions secret for .github/workflows/e2e-smoke.yml,
# alongside NEXT_PUBLIC_SUPABASE_URL above — that workflow signs a real test user up and
# tears them down again via the admin API, against a real deployed Preview URL.
SUPABASE_SERVICE_ROLE_KEY=

# --- Polar (payments) ---
# From Polar dashboard → Settings → Developers. Server-only: used to create checkout
# sessions and to verify webhook signatures.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "production" once this product's own real Polar organization is live; anything else
# (including unset) uses the sandbox API. Deliberately explicit, never inferred from
# which Vercel environment this is running in — see src/lib/polar/client.ts.
POLAR_SERVER=

# --- Plausible (analytics) ---
# The domain this site is registered under in Plausible. Public: it's read by the
# analytics script tag that runs in the browser.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
